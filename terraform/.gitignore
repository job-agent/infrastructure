# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude .tfvars files (may contain secrets)
*.tfvars
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files if they exist for development
.terraform.lock.hcl

# Terraform directory
.terraform/

# CLI configuration files
.terraformrc
terraform.rc
